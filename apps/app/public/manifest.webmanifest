{
  "name": "Munshi — Expense Tracker",
  "short_name": "Munshi",
  "description": "A private expense tracker that keeps the books in your own Google Sheet.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#FFF6E8",
  "theme_color": "#073D2B",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add expense",
      "short_name": "Expense",
      "url": "/#/?type=expense",
      "description": "Log a debit"
    },
    {
      "name": "Add income",
      "short_name": "Income",
      "url": "/#/?type=income",
      "description": "Log a credit"
    }
  ]
}
